{
    "require": {
        "php": ">=8.5",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/error-handler": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/cache": "^8.1",
        "symfony/ai-bundle": "",
        "symfony/ai-agent": "",
        "symfony/ai-platform": ""
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Darkwood\\IaExceptionBundle\\": "../../src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darkwood\\IaExceptionBundle\\Tests\\": "../../tests"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": false,
            "symfony/flex": false
        }
    }
}
