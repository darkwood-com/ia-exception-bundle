{
    "name": "darkwood/ia-exception-bundle",
    "description": "Augments HTTP 500 errors with AI-based exception analysis using Symfony AI",
    "type": "symfony-bundle",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/error-handler": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/cache": "^8.1",
        "symfony/ai-bundle": "^0.9.0",
        "symfony/ai-agent": "^^0.9.0",
        "symfony/ai-platform": "^0.9.0"
    },
    "require-dev": {
    },
    "autoload": {
        "psr-4": {
            "Darkwood\\IaExceptionBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darkwood\\IaExceptionBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "tools/phpunit/vendor/bin/phpunit --configuration=tools/phpunit/phpunit.dist.xml",
        "php-cs-fixer": [
            "composer install -d tools/php-cs-fixer",
            "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --config tools/php-cs-fixer/.php-cs-fixer.php --dry-run --diff"
        ],
        "phpstan": [
            "composer install -d tools/phpstan",
            "tools/phpstan/vendor/bin/phpstan analyse --configuration=tools/phpstan/phpstan.neon --memory-limit=1024M"
        ],
        "phpunit": [
            "composer install -d tools/phpunit",
            "tools/phpunit/vendor/bin/phpunit --configuration=tools/phpunit/phpunit.dist.xml"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^8.1"
        }
    }
}
